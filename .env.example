# Copie ce fichier en .env (jamais versionné) et adapte les valeurs.
#   cp .env.example .env

# Dossier où sont stockés les fichiers de données (stock.txt, mouvements.txt,
# fournisseurs.txt, commandes.txt, utilisateurs.txt, alertes.log).
# Optionnel : "data/" par défaut si absent.
DATA_PATH=data/

# Amorçage du PREMIER compte administrateur, utilisé une seule fois, au tout
# premier démarrage (tant qu'aucun utilisateur n'existe dans data/utilisateurs.txt).
# Le mot de passe est haché avant d'être stocké — jamais conservé en clair.
# Si ces deux variables sont absentes, le premier compte admin est créé de façon
# interactive au démarrage à la place.
# Optionnel au-delà du tout premier lancement : sans effet une fois un admin créé.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-moi
