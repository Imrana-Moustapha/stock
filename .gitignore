# Fichiers objets et dépendances générés par la compilation
*.o
*.d

# Exécutable du projet (désormais généré dans bin/)
bin/*
!bin/.gitkeep
mon_programme

# Données de persistance générées au runtime
data/*
!data/.gitkeep

# Fichiers temporaires d'éditeurs
*.swp
*~

# Dossiers de build éventuels
build/
