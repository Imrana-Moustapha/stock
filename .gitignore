# Fichiers objets et dépendances générés par la compilation
*.o
*.d

# Exécutables du projet (générés dans bin/ ou à la racine par CMake)
bin/*
!bin/.gitkeep
mon_programme
cpp

# Données de persistance générées au runtime
data/*
!data/.gitkeep

# Artefacts de compilation des tests
tests/tests

# Fichiers temporaires d'éditeurs
*.swp
*~

# Dossier de build (CMake)
build/
!build/.gitkeep