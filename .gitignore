# Fichiers objets et dépendances générés par la compilation
*.o
*.d

# Exécutable du projet (désormais généré dans bin/)
bin/*
!bin/.gitkeep
mon_programme

# Données de persistance générées au runtime
data/*
!data/.gitkeep

# Artefacts de compilation des tests (le code source, lui, reste versionné ;
# *.o et *.d ci-dessus couvrent déjà les fichiers objets, y compris tests/vendor/)
tests/tests

# Fichiers temporaires d'éditeurs
*.swp
*~

# Dossiers de build éventuels
build/